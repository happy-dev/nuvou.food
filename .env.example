# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Neon Postgres connection string (Neon dashboard → select the branch → Connect, pooled).
# Use the "dev" branch locally. Keep sslmode=verify-full (encrypted + server identity checked).
DATABASE_URL=postgresql://user:password@host-pooler.eu-central-1.aws.neon.tech/nuvou?sslmode=verify-full&channel_binding=require

# Long random string that signs admin sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
