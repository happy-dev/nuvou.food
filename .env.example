# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Neon Postgres connection string (Neon dashboard → Connect → "Connection string")
DATABASE_URL=postgresql://user:password@host.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Long random string that signs admin sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
